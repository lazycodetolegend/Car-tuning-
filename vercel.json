{
  "rewrites": [
    {
      "source": "/",
      "destination": "/homepage.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|gltf|bin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
