rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cars collection - authenticated users can read, only admins can write
    match /cars/{carId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Tunings collection - authenticated users can read/write their own tunings
    match /tunings/{tuningId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Projects collection - authenticated users can read/write their own projects
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Health check collection - allow writes for testing
    match /_health/{document} {
      allow read, write: if true;
    }
  }
}
