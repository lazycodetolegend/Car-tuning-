# Files that should not be uploaded to Vercel.
# The deployed site only needs the HTML pages, CSS, JS, images, audio
# and the two model folders.

# --- Express API: deployed separately (Render), not part of the static site ---
backend/

# --- Blender sources / backups: dev-only, ~368 MB ---
**/*.blend
**/*.blend1

# --- duplicate model copies sitting in the repo root (the site loads
#     everything from models/ and rims/) ---
/*.glb
/*.riv

# --- Firebase hosting placeholder + configs not served by the static site ---
public/
firebase.json
firestore.rules
firestore.indexes.json
storage.rules
deploy.js
car-tuinning-firebase-adminsdk*.json

# --- docs ---
*.md

# --- housekeeping ---
.git/
.gitignore
.vercelignore
node_modules/
*.log