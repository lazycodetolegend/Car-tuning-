PORT=5000
NODE_ENV=development
# Replace with your MongoDB Atlas connection URI (e.g. mongodb:// or Atlas connection string)
MONGODB_URI=mongodb://<user>:<password>@<cluster>.mongodb.net/car-tuning-app?retryWrites=true&w=majority
JWT_SECRET=<generate a long random string>
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=<from Cloudinary dashboard>
CLOUDINARY_API_KEY=<from Cloudinary dashboard>
CLOUDINARY_SECRET=<from Cloudinary dashboard>
CORS_ORIGIN=https://<your-vercel-domain>.vercel.app,http://localhost:5173,http://127.0.0.1:8080,http://localhost:5000
